server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Static assets can be cached hard (hashed filenames); index.html must not be.
  location = /index.html {
    add_header Cache-Control "no-cache";
  }
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # API proxy — same-origin /api/<service> forwards to each backend. The trailing
  # slash on proxy_pass strips the /api/<service> prefix. The browser sends the
  # user's Authorization bearer (production auth); nginx passes it through.
  location /api/tessera/ {
    proxy_pass ${TESSERA_UPSTREAM}/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
  location /api/vestigia/ {
    proxy_pass ${VESTIGIA_UPSTREAM}/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
  location /api/verityflux/ {
    proxy_pass ${VERITYFLUX_UPSTREAM}/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # SPA: every other path serves the app shell (client-side routing).
  location / {
    try_files $uri $uri/ /index.html;
  }
}
