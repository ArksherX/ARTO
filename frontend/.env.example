# API base URLs. In dev these are proxied by Vite (see vite.config.ts) to avoid
# CORS; in production set them to the deployed ingress paths/hosts.
VITE_TESSERA_API_BASE=/api/tessera
VITE_VESTIGIA_API_BASE=/api/vestigia
VITE_VERITYFLUX_API_BASE=/api/verityflux

# Production auth gate: when true, the app requires login and sends the user bearer.
# Leave unset/false in dev (the proxy injects service keys).
VITE_REQUIRE_LOGIN=false
