# =============================================================================
# ARTO suite — environment template
# =============================================================================
#
#   cp .env.example .env    &&    edit the values below
#
# .env is gitignored; this template is not. Never put a real secret in here.
# Every variable below is read by application code — see ops/internal/secrets_env.md
# for the fuller reference.
#
# IMPORTANT — values are read once at process startup. There is no hot-reload,
# so rotating any secret requires restarting the affected service.
# =============================================================================

# ─── Deployment mode ─────────────────────────────────────────────────────────
# Setting ANY of these to a production value makes the services fail closed:
# they will refuse to start on a missing secret, and refuse the built-in
# development fallback key outright. Leave unset for local development.
# TESSERA_ENV=production
# MLRT_MODE=prod
# MODE=prod
# SUITE_STRICT_MODE=true

# ─── Tessera (identity / delegation) ─────────────────────────────────────────
# REQUIRED in production. Minimum 64 bytes (128 hex chars). Generate with:
#   python -c "import secrets; print(secrets.token_hex(64))"
# A development fallback exists in source for local use only — it is public,
# and production startup rejects it.
TESSERA_SECRET_KEY=

# Admin endpoints. Change from the shipped default before exposing anything.
TESSERA_ADMIN_KEY=

# Where the root signing key is persisted.
TESSERA_ROOT_KEY_PATH=./data/tessera_root_key.json

# Runtime security controls. DPoP (RFC 9449) is per-request proof-of-possession.
TESSERA_REQUIRE_DPOP=true
TESSERA_REQUIRE_MEMORY_BINDING=false
TESSERA_REQUIRE_ACTION_SIGNATURE=false

# Requests per window against /access/validate before denials kick in.
TESSERA_ACCESS_RATE_LIMIT=100

# ─── Vestigia (audit ledger / forensics) ─────────────────────────────────────
# REQUIRED. Gates event ingest and read.
VESTIGIA_API_KEY=

# Salt for hashed identifiers in the ledger. Changing it breaks correlation
# with previously written events.
VESTIGIA_SECRET_SALT=

# ─── VerityFlux (scanning / enforcement) ─────────────────────────────────────
VERITYFLUX_API_KEY=

# JWT validation activates when a secret is present — there is no separate
# enable flag. Use >=32 bytes (RFC 7518 §3.2); below that PyJWT warns.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VERITYFLUX_JWT_SECRET=
VERITYFLUX_JWT_ALGORITHM=HS256
# Optional — verified only when set.
VERITYFLUX_JWT_ISSUER=
VERITYFLUX_JWT_AUDIENCE=

# Enforcement toggles.
VERITYFLUX_REQUIRE_TRUSTED_CONTEXT=false
VERITYFLUX_REQUIRE_SANDBOX_FOR_EXEC=true

# ─── Cross-service integration (optional) ────────────────────────────────────
MLRT_INTEGRATION_ENABLED=false
MLRT_VESTIGIA_INGEST_URL=http://localhost:8200/events
MLRT_VESTIGIA_API_KEY=

# ─── Redis ───────────────────────────────────────────────────────────────────
# Backs rate limiting and DPoP replay protection. Losing it degrades those
# controls, so treat it as security-relevant rather than cache-only.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ─── TLS ─────────────────────────────────────────────────────────────────────
# For STANDALONE / non-Kubernetes deployments only.
#
# Under Kubernetes, TLS terminates at the ingress (cert-manager) — leave these
# unset there, or certificate renewal turns into a pod restart. See
# ops/hardening_playbook.md § "Where TLS terminates".
#
# Per-service values fall back to the shared TLS_CERTFILE / TLS_KEYFILE.
# TESSERA_TLS_CERTFILE=
# TESSERA_TLS_KEYFILE=
# VESTIGIA_TLS_CERTFILE=
# VESTIGIA_TLS_KEYFILE=
# VERITYFLUX_TLS_CERTFILE=
# VERITYFLUX_TLS_KEYFILE=
# TLS_CERTFILE=
# TLS_KEYFILE=

# ============================================================================
# NVIDIA NIM — VerityFlux adversarial scoring + optional NeMoGuard detector
# ============================================================================
# Get a key at https://build.nvidia.com (sign in with the NVIDIA Inception
# account to receive the member allocation rather than the public tier).
NVIDIA_API_KEY=
# Optional: override only for a self-hosted NIM. Default is the hosted endpoint
# https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=

# Adversarial scorer: set provider to "nvidia" to use NIM instead of the mock.
# The adapter falls back to NVIDIA_API_KEY when VERITYFLUX_SCORER_API_KEY is unset.
VERITYFLUX_SCORER_PROVIDER=mock
VERITYFLUX_SCORER_MODEL=
VERITYFLUX_SCORER_API_KEY=

# NeMoGuard jailbreak/safety classifier — DISABLED by default.
# NOTE: pick a model that exists in the NIM catalogue, e.g.
#   nvidia/llama-3.1-nemoguard-8b-content-safety
#   nvidia/llama-3.1-nemotron-safety-guard-8b-v3
VERITYFLUX_NEMOGUARD_ENABLED=false
VERITYFLUX_NEMOGUARD_MODEL=
VERITYFLUX_NEMOGUARD_API_KEY=
